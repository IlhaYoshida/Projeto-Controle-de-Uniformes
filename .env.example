# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# String de conexão com o PostgreSQL.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://uniformes_user:uniformes_pass@localhost:5432/uniformes_db
